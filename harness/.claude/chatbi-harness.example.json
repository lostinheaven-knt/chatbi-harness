{
  "description": "ChatBI harness workspace configuration. Edit per docs/chatbi-harness-domain-model.md.",
  "schema_version": 1,
  "workspace": {
    "id": "warehouse",
    "root": ".",
    "allow_candidate_writes": true,
    "protected_actions": [
      "approve_metric",
      "change_access_policy",
      "production_publish",
      "destructive_migration"
    ]
  },
  "business_codebases": {
    "billing_app": {
      "description": "Synthetic billing event producer",
      "path_ref": "billing_app_root",
      "read_mode": "adapter",
      "git_history": "metadata_only"
    },
    "product_docs": {
      "description": "Product documentation codebase (read-only reference)",
      "path_ref": "product_docs_root",
      "read_mode": "adapter",
      "git_history": "metadata_only"
    }
  },
  "adapters": {
    "semantic": [
      "cli:semantic"
    ],
    "query": [],
    "fixture_enabled": false
  },
  "governance": {
    "pii_policy_ref": null,
    "restricted_disclosure": null,
    "owners": {
      "default_domain_owner": null,
      "metrics": {}
    },
    "high_risk_classes": [
      "executive",
      "regulated_or_pii",
      "core_finance",
      "raw_exploration",
      "freshness_unknown"
    ],
    "coverage_policy": {
      "low_confidence_missing_ratio": 0.2,
      "stale_after_days": 7,
      "owner": "domain-owner"
    }
  },
  "evaluation": {
    "release_threshold": null,
    "threshold_owner": null,
    "require_p0_slices": true
  },
  "runtime": {
    "evidence_root": ".chatbi",
    "fail_if_sandbox_unavailable": true
  }
}
