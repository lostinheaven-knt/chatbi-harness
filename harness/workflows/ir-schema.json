{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ir-schema.json",
  "title": "ChatBI Harness IR schema (chatbi.harness/v1)",
  "description": "Declarative contract for the nine governed workflow declarations (module 3, stage C-1). The enforcement path is the field-level Python model in harness/packages/chatbi_harness_ir (schema.py/loader.py/validator.py); this file documents the same contract for humans and tooling. Portability: the IR must never contain machine paths, secrets, or command names other than /chatbi-xxx (PORT-001/SEC-003, invariant 5).",
  "x-implemented-keywords": [
    "type",
    "required",
    "properties",
    "additionalProperties",
    "enum",
    "pattern",
    "minItems",
    "uniqueItems",
    "items"
  ],
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "workflow_version",
    "title",
    "description",
    "entry",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "chatbi.harness/v1",
      "description": "Major mismatch (name != chatbi.harness or major != 1) is rejected at load time (design §13 rule 1)."
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Globally unique across the nine workflows; must equal the filename stem and entry.command."
    },
    "workflow_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entry": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "argument_hint": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "executor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "executor": {
            "type": "string",
            "enum": [
              "deterministic",
              "agent_with_tools",
              "independent_reviewer",
              "human_approval",
              "runtime_native"
            ]
          },
          "function": {
            "type": "string",
            "pattern": "^chatbi_governance\\.[A-Za-z0-9_.]+$"
          },
          "when": {
            "type": "string",
            "description": "Controlled condition grammar (chatbi_harness_ir.conditions): always|never|evidence.has_gap(T1|T2)|evidence.has(T1|T2|T3)|request.field_is(field,value)|owner.pending(action)|delivery_decision.is_pass|(…) — no eval."
          },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "tools": { "$ref": "#/$defs/tools" },
          "review_required": { "type": "boolean" },
          "review_schema": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Z]{2,6}-\\d{3}$" }
            },
            "terminal_only": {
              "type": "boolean",
              "description": "True: run.completed may only be emitted after this gate PASS (design §5.2, ADR-002)."
            }
          }
        }
      }
    },
    "requirements": { "$ref": "#/$defs/levels" },
    "capabilities": { "$ref": "#/$defs/levels" },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "path": {
            "type": "string",
            "description": "Workspace-relative path into prompts/manifest.json (PORT-001: no absolute paths)."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Must match the registered content hash in prompts/manifest.json."
          }
        }
      }
    },
    "tools": { "$ref": "#/$defs/tools" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
        "schema_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Command inter-calls (FF§3.3.3) as workflow ids or the sentinels 'none'/'owner'."
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deprecated_fields": { "type": "array", "items": { "type": "string" } },
        "migration": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        },
        "deny": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        }
      },
      "description": "allow and deny must not intersect (validator)."
    },
    "levels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["required", "optional", "protected_actions", "none"]
      }
    }
  }
}
